# =============================================================================
# Multimodal RAG – environment configuration
# Copy to `.env` and adjust:   cp .env.example .env
#
# Every variable maps 1:1 to a field of `app.core.config.Settings` (uppercase).
# APP_ENV selects an optional overlay file `.env.<APP_ENV>` (e.g. `.env.production`)
# that is loaded on top of `.env`. Real environment variables always win.
# In docker-compose, REDIS_URL / QDRANT_URL / DATA_DIR / OLLAMA_BASE_URL are
# overridden to point to the internal service names.
# =============================================================================

# --- App ---------------------------------------------------------------------
# development | test | production
APP_ENV=development
APP_NAME="Multimodal RAG"
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# structured JSON logs (false = human readable)
LOG_JSON=true
API_PREFIX=/api/v1
# JSON list (pydantic-settings parses complex types as JSON)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
MAX_UPLOAD_MB=50
# uploads/ and images/ live here (/data in Docker)
DATA_DIR=./data

# --- Infrastructure ----------------------------------------------------------
# Celery broker/result backend + job store
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
# only for Qdrant Cloud / secured instances
# QDRANT_API_KEY=
QDRANT_COLLECTION=documents
# Language of the BM25 sparse vectors (Snowball stemmer + stop-words): spanish |
# english | portuguese | french | german | italian | ... Must match the documents'
# language. Changing it changes the sparse token ids -> recreate the collection
# (or use a new QDRANT_COLLECTION) and re-ingest.
BM25_LANGUAGE=spanish

# --- LLM ---------------------------------------------------------------------
# openai | ollama
LLM_PROVIDER=openai
# required when LLM_PROVIDER/EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
# optional: Azure/OpenAI-compatible gateway
# OPENAI_BASE_URL=
# vision-capable -> image descriptions
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=http://localhost:11434
# multimodal + good Spanish, ~3.3 GB, runs on CPU (pulled by the ollama-pull service).
# Bigger/better with a GPU: llama3.2-vision, gemma3:12b, qwen2.5vl:7b
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# deterministic, minimizes hallucinations
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
# CPU inference with Ollama is slow: keep this generous
LLM_TIMEOUT_SECONDS=180

# --- Embeddings --------------------------------------------------------------
# fastembed (local CPU, default) | openai | ollama
EMBEDDING_PROVIDER=fastembed
# Multilingual (ES/EN, 50+ languages), 384 dims, ~0.22 GB, fast on CPU. Chosen by a
# benchmark on the Spanish sample manual (see docs/adr/0008). Alternatives:
#   intfloat/multilingual-e5-large (1024 d, 2.2 GB, ~20x slower; slightly better)
#   sentence-transformers/paraphrase-multilingual-mpnet-base-v2 (768 d, 1 GB)
#   BAAI/bge-small-en-v1.5 (English-only corpora)
# The Docker image pre-downloads the model given here at build time.
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_BATCH_SIZE=32
# NOTE: changing the embedding provider/model changes the vector space (and often the
# dimension): use a new QDRANT_COLLECTION (or delete the old one) and re-ingest.

# --- Ingestion ---------------------------------------------------------------
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_SENTENCES=1
# ignore icons/decorations smaller than this
MIN_IMAGE_SIZE_PX=64
# PDF points between a chunk and a linked image
IMAGE_LINK_MAX_DISTANCE=150
# describe images with the vision LLM (if supported)
DESCRIBE_IMAGES=true

# --- Retrieval ---------------------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.0
MAX_IMAGES_PER_ANSWER=2
HISTORY_MAX_TURNS=6

# --- Resilience --------------------------------------------------------------
RETRY_MAX_ATTEMPTS=4
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_SECONDS=30
